# 数据库配置
DATABASE_PATH=./data/browser_automation.db

# 浏览器配置
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000  # 30秒超时

# 调度配置
SCHEDULE_INTERVAL=60000  # 1分钟间隔（毫秒）
MAX_RETRIES=2

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 按钮选择器配置（可选，优先级顺序）
BUTTON_SELECTORS=.btn-primary,#submit-button,button[type="submit"]